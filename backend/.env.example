PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
# For Gmail: leave SMTP_HOST empty, set SMTP_SERVICE=gmail, SMTP_USER=you@gmail.com,
# and SMTP_PASS=<16-character Gmail App Password> (requires 2-Step Verification enabled
# on the Google account; App Passwords are generated at https://myaccount.google.com/apppasswords).
# For any other provider: leave SMTP_SERVICE empty and set SMTP_HOST/SMTP_PORT instead.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@closetai.app
